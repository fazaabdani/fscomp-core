generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEKNISI
  SALES
  MAGANG
}

enum UnitStatus {
  VERIFIED
  VERIFIED_WITH_NOTES
  RECHECK
  CANDIDATE_RETUR
  RETUR_DISTRIBUTOR
}

enum QcResult {
  OK
  NOTES
  FAIL
}

enum DailyStatus {
  LOLOS
  LOLOS_DENGAN_CATATAN
  TIDAK_LOLOS
}

enum PaymentStatus {
  BELUM_JATUH_TEMPO
  MENDEKATI_TEMPO
  BUTUH_FOLLOW_UP
  LUNAS
}

enum AiLogStatus {
  OPEN
  DONE
}

enum CatalogSyncStatus {
  DRAFT
  READY
  SYNCED
  FAILED
}

enum SaleLocation {
  WIRADESA
  KAJEN
}

enum InventoryItemStatus {
  STOCK
  USED_IN_UNIT
  SOLD
  RETURNED
  DAMAGED
  LOST
}

enum WarrantyDurationUnit {
  DAY
  WEEK
  MONTH
  YEAR
}

enum LicenseType {
  OFFICE
  WINDOWS
  ANTIVIRUS
  OTHER
}

enum LicenseDurationType {
  LIFETIME
  YEARLY
  CUSTOM
}

enum LicenseStatus {
  AVAILABLE
  ASSIGNED
  SENT
  PROBLEM
  REPLACED
}

enum PcComponentCategory {
  CPU
  MOTHERBOARD
  RAM
  STORAGE
  GPU
  PSU
  CASING
  COOLER
  MONITOR
  ACCESSORY
}

enum PcBuildDraftStatus {
  NEW
  CONTACTED
  QUOTED
  CONFIRMED
  CANCELLED
}

enum WaCustomerAiPolicy {
  AUTO_SAFE
  ADMIN_ONLY
  VIP_ADMIN_ONLY
  BLOCKED_AI
}

enum WaConversationStatus {
  OPEN
  PENDING_ADMIN
  WAITING_ADMIN
  CLOSED
  DEAL
  LOST
  ARCHIVED
}

enum WaLeadScore {
  COLD
  WARM
  HOT
}

enum WaRiskLevel {
  SAFE
  WATCH
  RISK
}

enum WaMessageDirection {
  INBOUND
  AI_OUTBOUND
  ADMIN_OUTBOUND
  SYSTEM
}

enum WaAiEventStatus {
  INFO
  SKIPPED
  QUEUED
  SENT
  FAILED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  username  String?  @unique
  password  String?
  role      Role
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  qcAwal    QcAwal[]
  qcHarian  QcHarian[]
  attendance Attendance[]
  inventoryItems InventoryItem[]
  licenseRecords LicenseRecord[]
  mediaAssets MediaAsset[]
}

model Attendance {
  id          String   @id @default(cuid())
  userId      String
  tanggal     DateTime @default(now())
  checkInAt   DateTime @default(now())
  checkOutAt  DateTime?
  status      String   @default("HADIR")
  note        String?
  photoDataUrl String?
  latitude    Float?
  longitude   Float?
  accuracy    Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id])
}

model BatchPSI {
  id               String        @id @default(cuid())
  nomorBatch       String        @unique
  supplier         String
  tanggalMasuk     DateTime
  tanggalTempo     DateTime
  jumlahLaptopDatang Int?
  jumlahChargerDatang Int?
  chargerCounts    Json?
  statusPembayaran PaymentStatus @default(BELUM_JATUH_TEMPO)
  catatan          String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  units Unit[]
}

model Unit {
  id                   String     @id @default(cuid())
  nomorUnit            String
  batchId              String
  supplier             String
  model                String
  processor            String
  ram                  String
  ssd                  String
  ssdSerial            String?
  chargerType          String?
  lcdSize              String?
  lcdResolution        String?
  isTouchscreen        Boolean    @default(false)
  entryNotes           String?
  hargaModal           Int
  hargaJualRekomendasi Int
  stockLocation        SaleLocation @default(WIRADESA)
  batteryHealth        Int?
  ssdHealth            Int?
  statusObservasi      UnitStatus @default(RECHECK)
  tanggalMasuk         DateTime
  tempo                DateTime?
  catalogLiveUrl       String?
  catalogImageUrl      String?
  soldAt               DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  batch       BatchPSI      @relation(fields: [batchId], references: [id])
  qcAwal      QcAwal?
  qcHarian    QcHarian[]
  aiLogs      AiLog[]
  catalogSync CatalogSync[]
  sales       Sale[]
  auditLogs   UnitAuditLog[]
  inventoryItems InventoryItem[]
  licenseRecords LicenseRecord[]
  unitPhotos  UnitPhoto[]

  @@unique([batchId, nomorUnit])
}

model MediaFolder {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   MediaFolder?  @relation("MediaFolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children MediaFolder[] @relation("MediaFolderChildren")
  assets   MediaAsset[]

  @@index([parentId])
}

model MediaAsset {
  id           String   @id @default(cuid())
  folderId     String?
  fileName     String
  originalName String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  uploadedById String?
  createdAt    DateTime @default(now())

  folder     MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploadedBy User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  unitPhotos UnitPhoto[]

  @@index([folderId])
}

model UnitPhoto {
  id        String   @id @default(cuid())
  unitId    String
  assetId   String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  unit  Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  asset MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([unitId, assetId])
  @@index([unitId, order])
}

model InventoryItem {
  id                    String                @id @default(cuid())
  category              String
  name                  String
  brandModel            String?
  specification         String?
  serialNumber          String?
  supplier              String
  invoiceNumber         String?
  invoiceImageUrl       String?
  purchaseDate          DateTime
  arrivedAt             DateTime              @default(now())
  warrantyDuration      Int                   @default(0)
  warrantyDurationUnit  WarrantyDurationUnit  @default(MONTH)
  status                InventoryItemStatus   @default(STOCK)
  unitId                String?
  buyerName             String?
  buyerPhone            String?
  costPrice             Int                   @default(0)
  notes                 String?
  createdById           String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  unit                  Unit?                 @relation(fields: [unitId], references: [id])
  createdBy             User?                 @relation(fields: [createdById], references: [id])
  pcComponent           PcComponent?

  @@index([category, status])
  @@index([supplier])
  @@index([serialNumber])
  @@index([purchaseDate])
}

model PcComponent {
  id              String              @id @default(cuid())
  inventoryItemId String?             @unique
  category        PcComponentCategory
  name            String
  brand           String?
  specification   String?
  salePrice       Int
  socket          String?
  supportedSockets String[]
  memoryType      String?
  formFactor      String?
  supportedFormFactors String[]
  storageInterface String?
  supportedStorageInterfaces String[]
  powerDraw       Int?
  psuCapacity     Int?
  gpuLengthMm     Int?
  maxGpuLengthMm  Int?
  coolerHeightMm  Int?
  maxCoolerHeightMm Int?
  radiatorSizeMm  Int?
  supportedRadiatorSizes Int[]
  active          Boolean             @default(true)
  sortOrder       Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  inventoryItem   InventoryItem?      @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  presetItems     PcBuildPresetItem[]

  @@index([category, active, sortOrder])
}

model PcBuildPreset {
  id          String              @id @default(cuid())
  name        String              @unique
  slug        String              @unique
  description String?
  useCase     String
  active      Boolean             @default(true)
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  items       PcBuildPresetItem[]
}

model PcBuildPresetItem {
  id          String        @id @default(cuid())
  presetId    String
  componentId String

  preset      PcBuildPreset @relation(fields: [presetId], references: [id], onDelete: Cascade)
  component   PcComponent   @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([presetId, componentId])
}

model PcBuildDraft {
  id            String             @id @default(cuid())
  referenceCode String             @unique
  presetName    String?
  customerName  String?
  customerPhone String?
  need          String?
  budget        Int?
  totalPrice    Int
  status        PcBuildDraftStatus @default(NEW)
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  items         PcBuildDraftItem[]

  @@index([status, createdAt])
}

model PcBuildDraftItem {
  id            String       @id @default(cuid())
  draftId       String
  componentId   String?
  category      String
  componentName String
  unitPrice     Int

  draft         PcBuildDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId])
}

model WaCustomer {
  id               String             @id @default(cuid())
  phone            String             @unique
  name             String?
  customerAiPolicy WaCustomerAiPolicy @default(AUTO_SAFE)
  isKnownCustomer  Boolean            @default(false)
  lastDealAt       DateTime?
  notes            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  conversations    WaConversation[]

  @@index([customerAiPolicy])
  @@index([isKnownCustomer, updatedAt])
}

model WaConversation {
  id                    String               @id @default(cuid())
  customerId            String
  phone                 String
  status                WaConversationStatus @default(OPEN)
  leadScore             WaLeadScore          @default(COLD)
  riskLevel             WaRiskLevel          @default(SAFE)
  intent                String?
  summary               String?
  lastMessageAt         DateTime?
  lastAdminResponseAt   DateTime?
  lastAiResponseAt      DateTime?
  aiTakeoverAllowed     Boolean              @default(true)
  followupPassiveSentAt DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  customer              WaCustomer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages              WaMessage[]
  events                WaAiEventLog[]
  telegramNotifications WaTelegramNotificationLog[]

  @@index([status, updatedAt])
  @@index([phone, updatedAt])
  @@index([leadScore, riskLevel])
  @@index([customerId, updatedAt])
}

model WaMessage {
  id             String             @id @default(cuid())
  conversationId String
  direction      WaMessageDirection
  senderName     String?
  body           String
  rawPayload     Json?
  createdAt      DateTime           @default(now())

  conversation   WaConversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([direction, createdAt])
}

model WaAiSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WaAiEventLog {
  id             String          @id @default(cuid())
  conversationId String?
  eventType      String
  status         WaAiEventStatus @default(INFO)
  reason         String?
  payload        Json?
  createdAt      DateTime        @default(now())

  conversation   WaConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([eventType, createdAt])
  @@index([status, createdAt])
}

model WaTelegramNotificationLog {
  id             String          @id @default(cuid())
  conversationId String?
  eventType      String
  dedupeKey      String?         @unique
  sentAt         DateTime?
  status         WaAiEventStatus @default(QUEUED)
  error          String?
  createdAt      DateTime        @default(now())

  conversation   WaConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([eventType, createdAt])
  @@index([status, createdAt])
}

model UnitAuditLog {
  id            String   @id @default(cuid())
  unitId        String
  action        String
  actorName     String
  actorUsername String?
  actorRole     String?
  changes       Json
  createdAt     DateTime @default(now())

  unit          Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId, createdAt])
}

model QcAwal {
  id              String     @id @default(cuid())
  unitId          String     @unique
  checkerId       String
  tanggal         DateTime
  status          UnitStatus

  body            QcResult
  bodyBroken      QcResult
  karetBawah      QcResult
  repaint         QcResult
  layar           QcResult
  ukuranLcd       QcResult
  resolusiLayar   QcResult
  touchscreen     QcResult
  keyboard        QcResult
  touchpad        QcResult
  trackpoint      QcResult
  usb             QcResult
  kamera          QcResult
  port            QcResult
  speaker         QcResult
  mic             QcResult
  charger         QcResult
  battery         QcResult
  ssd             QcResult
  seriSsd         QcResult

  osInstalled     QcResult
  windowsVersion  String     @default("Windows 11")
  updateOs        QcResult
  driver          QcResult
  securityPatch   QcResult
  aplikasiDefault QcResult

  reminder        String[]
  catatan         String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  unit            Unit       @relation(fields: [unitId], references: [id])
  checker         User       @relation(fields: [checkerId], references: [id])
}

model QcHarian {
  id              String      @id @default(cuid())
  unitId          String
  checkerId       String
  tanggal         DateTime
  ssdHealth       Int
  batteryHealth   Int
  ssdSerial       String?
  screenCondition String      @default("Normal")
  windowsVersion  String      @default("Windows 10")
  driverStatus    String      @default("OK")
  clockStatus     String      @default("OK")
  appStatus       String      @default("OK")
  officeStatus    String      @default("Tidak dicek")
  partitionCount  Int         @default(1)
  nyalaNormal     Boolean
  booting         Boolean
  layar           Boolean
  keyboard        Boolean
  keyboardBacklight Boolean @default(false)
  ssd             Boolean
  battery         Boolean
  port            Boolean
  usb             Boolean     @default(true)
  camera          Boolean     @default(true)
  touchpad        Boolean     @default(true)
  trackpoint      Boolean     @default(true)
  bodyBroken      Boolean     @default(false)
  karetBawah      Boolean     @default(true)
  paintCondition  String?
  speaker         Boolean     @default(true)
  mic             Boolean     @default(true)
  wifi            Boolean
  bluetooth       Boolean
  kondisiHariIni  String
  masihLolos      DailyStatus
  catatan         String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  unit            Unit        @relation(fields: [unitId], references: [id])
  checker         User        @relation(fields: [checkerId], references: [id])
}

model Sale {
  id            String       @id @default(cuid())
  unitId        String?
  invoiceNumber String       @unique
  location      SaleLocation
  soldPrice     Int
  costPrice     Int
  subtotal      Int          @default(0)
  dpAmount      Int          @default(0)
  grossProfit   Int
  paymentMethod String
  buyerName     String?
  buyerPhone    String?
  buyerAddress  String?
  warrantySoftware String    @default("3 bulan")
  warrantyHardware String    @default("3 minggu")
  soldAt        DateTime     @default(now())
  voidedAt      DateTime?
  voidReason    String?
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  unit          Unit?        @relation(fields: [unitId], references: [id])
  items         SaleItem[]
  licenseRecords LicenseRecord[]
}

model LicenseRecord {
  id             String              @id @default(cuid())
  name           String
  licenseType    LicenseType
  version        String
  edition        String?
  productKey     String?
  durationType   LicenseDurationType @default(LIFETIME)
  purchaseDate   DateTime
  validUntil     DateTime?
  status         LicenseStatus       @default(ASSIGNED)
  supplier       String?
  buyerName      String?
  buyerPhone     String?
  unitId         String?
  saleId         String?
  laptopSeries   String?
  sourceItemName String?
  sourceItemCategory String?
  salePrice      Int                 @default(0)
  costPrice      Int                 @default(0)
  notes          String?
  createdById    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  unit           Unit?               @relation(fields: [unitId], references: [id])
  sale           Sale?               @relation(fields: [saleId], references: [id])
  createdBy      User?               @relation(fields: [createdById], references: [id])

  @@index([licenseType, status])
  @@index([buyerPhone])
  @@index([unitId])
  @@index([saleId])
  @@index([purchaseDate])
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  name        String
  category    String
  qty         Int      @default(1)
  unitPrice   Int
  unitCost    Int      @default(0)
  lineTotal   Int
  lineCost    Int      @default(0)
  createdAt   DateTime @default(now())

  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model AiLog {
  id          String      @id @default(cuid())
  unitId      String
  tanggal     DateTime    @default(now())
  rekomendasi String
  status      AiLogStatus @default(OPEN)
  source      String      @default("core-ai")
  createdAt   DateTime    @default(now())

  unit        Unit        @relation(fields: [unitId], references: [id])
}

model CatalogSync {
  id          String            @id @default(cuid())
  unitId      String
  status      CatalogSyncStatus @default(DRAFT)
  catalogUrl  String?
  lastSyncedAt DateTime?
  error       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  unit        Unit              @relation(fields: [unitId], references: [id])
}
